<Window x:Class="MuiltVoice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MuiltVoice.App.ViewModels"
        xmlns:app="clr-namespace:MuiltVoice.App"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="MuiltVoice — 多对多音频路由" Height="720" Width="1040" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowBase}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <!-- 辅助 converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:SummaryBadgeConverter x:Key="BadgeConverter" />

        <!-- Group Card ItemTemplate（列表中每个路由） -->
        <DataTemplate DataType="{x:Type vm:GroupViewModel}">
            <Border Style="{StaticResource GroupCard}" x:Name="Card">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：颜色小竖条（运行态绿色，其它淡灰） + 编辑入口点击区 -->
                    <Border Grid.Column="0" Width="6" CornerRadius="999" x:Name="LeftBar"
                            Background="#D0D9E3"/>

                    <!-- 中间主体：Header(名+徽章) / 两列(输入输出摘要) / 迷你电平条 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 头部：路由名 + 运行徽章 + 输入输出计数 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="2" Content="{Binding SummaryBadgeClass, Converter={StaticResource BadgeConverter}}"/>
                            <Border Grid.Column="4"
                                    CornerRadius="999" Padding="8,3"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#2DA985" Opacity="0.11"/>
                                </Border.Background>
                                <TextBlock Text="{Binding SelectedInputCount, StringFormat={}🎙 入 {0}}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Column="6"
                                    CornerRadius="999" Padding="8,3"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#79A6FF" Opacity="0.14"/>
                                </Border.Background>
                                <TextBlock Text="{Binding SelectedOutputCount, StringFormat={}🔊 出 {0}}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#3C6DC1"/>
                            </Border>
                        </Grid>

                        <!-- 中间：选中文本摘要（输入/输出名 逗号分隔） -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="输入："/>
                                <Run Text="{Binding Inputs, Converter={app:SelectedNamesConv}, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="输出："/>
                                <Run Text="{Binding Outputs, Converter={app:SelectedNamesConv}, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>

                        <!-- 底部：迷你电平条 -->
                        <Grid Grid.Row="4" Height="10">
                            <Border Style="{StaticResource MeterTrack}" Opacity="0.9"/>
                            <Border Style="{StaticResource MeterFill}" x:Name="MiniMeterFill" Width="0"/>
                        </Grid>
                    </Grid>

                    <!-- 右侧：动作按钮列（编辑 / 启停 / 删除） -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="编辑" Style="{StaticResource BtnIcon}" Margin="0,0,6,0"
                                Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="启动" Style="{StaticResource BtnPrimary}" Padding="14,7" Margin="0,0,6,0"
                                Command="{Binding StartCommand}"
                                Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="停止" Style="{StaticResource BtnNeutral}" Padding="14,7" Margin="0,0,6,0"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="删除" Style="{StaticResource BtnDanger}" Padding="14,7"
                                Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 触发器：把 PeakLevel 映射到 MiniMeterFill.Width；IsRunning 映射到 LeftBar 颜色 -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="LeftBar" Property="Background" Value="#2DA985"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Toolbar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 第 1 行：Logo + 全局操作 -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>   <!-- 第 2 行：方案管理 + Cable 提示 -->
                </Grid.RowDefinitions>

                <!-- ========== 第 1 行：Logo + 全局操作 ========== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：Logo + 标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource BrushPrimary}"
                                VerticalAlignment="Center" x:Name="LogoBox">
                            <TextBlock Text="🎵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Text="MuiltVoice"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Text="多对多音频路由 / 混音 / 分发"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中：全局控制按钮（居中展开） -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="全部启动" Style="{StaticResource BtnPrimary}" Command="{Binding StartAllCommand}" Margin="0,0,8,0"/>
                        <Button Content="全部停止" Style="{StaticResource BtnDanger}" Command="{Binding StopAllCommand}" Margin="0,0,8,0"/>
                        <Button Content="＋ 新建路由" Style="{StaticResource BtnGhost}" Command="{Binding AddGroupCommand}" Margin="0,0,8,0"/>
                        <Button Content="↻ 刷新设备" Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                        <Button Content="⚙ 设备设置" Style="{StaticResource BtnGhost}" Command="{Binding OpenDeviceSettingsCommand}"
                                ToolTip="打开设备设置页：单独管理每个输出设备的 WASAPI 独占模式（🔒 占用其他程序无法使用，延迟 ~10-30ms；🔓 共享）"/>
                    </StackPanel>
                </Grid>

                <!-- ========== 第 2 行：方案管理 + Cable 提示 ========== -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 左：Cable 安装提示（若未安装） -->
                    <TextBlock Grid.Column="0" x:Name="CableTipText"
                               VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource BrushAccent}"
                               Visibility="Collapsed"/>
                    <!-- 右：方案管理 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="方案：" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBox Style="{StaticResource BoxBasic}" Width="180" VerticalAlignment="Center" Margin="6,0,8,0"
                                 Text="{Binding CurrentProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Style="{StaticResource BoxCombo}" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ItemsSource="{Binding AvailableProfiles}"
                                  SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"/>
                        <Button Content="保存" Style="{StaticResource BtnGhost}" Padding="12,6" Margin="0,0,6,0"
                                Command="{Binding SaveProfileCommand}"/>
                        <Button Content="加载" Style="{StaticResource BtnGhost}" Padding="12,6"
                                Command="{Binding LoadProfileCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 中间：路由路由列表 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False" Padding="20,16,20,10">
                <ItemsControl ItemsSource="{Binding Groups}" x:Name="GroupList"/>
            </ScrollViewer>

            <!-- 右侧：Cable 提示条（常驻信息面板） -->
            <Border Grid.Column="1" Width="240" Margin="0,16,20,10" CornerRadius="14"
                    Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" Padding="14" Effect="{StaticResource ShadowCard}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="ℹ️  虚拟音频提示" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap">
                        MuiltVoice 使用系统真实音频端点。若你想把"合并后的音频"作为虚拟麦克风提供给会议软件（如 OBS、腾讯会议），需要安装 VB-Cable（单线缆免费），然后在输出端选择「CABLE Input」，会议软件输入端选择「CABLE Output」即可。
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,10,0,0"
                               Text="{Binding IsCableInstalled, Converter={app:CableTipConv}, Mode=OneWay}"/>
                    <Button Content="打开 VB-Cable 官网" x:Name="LinkCable"
                            Style="{StaticResource BtnIcon}" Margin="0,12,0,0"
                            Click="OpenCableWeb"
                            Foreground="{StaticResource BrushLink}"/>
                    <Border Margin="0,16,0,0" Height="1" Background="{StaticResource BrushBorder}"/>
                    <TextBlock Text="🔧 全局状态" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,6"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                               Text="{Binding RunningCount, StringFormat={}运行中的路由：{0} 个}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                               Text="{Binding Groups.Count, StringFormat={}共 {0} 个路由}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="12" Text="{Binding StatusText, Mode=OneWay}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="11" Text="MuiltVoice · 多对多音频路由 · 基于 NAudio"/>
            </Grid>
        </Border>
    </Grid>
</Window>
