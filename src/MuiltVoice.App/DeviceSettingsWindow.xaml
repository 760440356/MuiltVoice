<Window x:Class="MuiltVoice.App.DeviceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MuiltVoice.App.ViewModels"
        xmlns:app="clr-namespace:MuiltVoice.App"
        mc:Ignorable="d"
        Title="设备设置 · WASAPI 独占模式"
        Height="680" Width="1000" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F6F8FB"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Foreground="#2B3A55">
    <Window.Resources>
        <app:BoolToVisibilityHidden x:Key="Bool2Collapsed"/>
        <app:InverseBoolConverter x:Key="InvBool"/>

        <Style TargetType="CheckBox" x:Key="ChkBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Content" Value=""/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Width="20" Height="20" CornerRadius="5"
                                Background="#FFFFFF"
                                BorderBrush="#D9DFE9"
                                BorderThickness="1"
                                x:Name="Root">
                            <Path x:Name="Chk" Data="M4,10 L8,14 L16,6"
                                  Stroke="#2DA985"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chk" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2DA985"/>
                                <Setter TargetName="Root" Property="Background" Value="#E8F6F1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2DA985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="DeviceRowBorder">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5EAF2"/>
        </Style>

        <Style TargetType="Button" x:Key="DevSetBtnGhost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6A7A90"/>
            <Setter Property="BorderBrush" Value="#D9DFE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2DA985"/>
                                <Setter Property="Foreground" Value="#2DA985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B6C2D0"/>
                                <Setter TargetName="Root" Property="Background" Value="#F6F8FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DevSetBtnPrimary">
            <Setter Property="Background" Value="#2DA985"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#228B6C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#9BC7B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1C7A5D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DevSetBtnDanger">
            <Setter Property="Background" Value="#D14343"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#B33838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#942C2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ========== 内容层（主内容，加载时被遮罩覆盖） ========== -->
        <Grid Margin="24,20,24,20" x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙" FontSize="28" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="设备 WASAPI 独占模式设置" FontSize="18" FontWeight="SemiBold"
                               Foreground="#2B3A55"/>
                    <TextBlock Text="设备粒度开关：每个输出设备独立配置独占/共享。输入设备由系统音频引擎混音，不支持独占。"
                               FontSize="12" Foreground="#6A7A90"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource DeviceRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="共" FontSize="12" Foreground="#6A7A90" VerticalAlignment="Center"/>
                        <Border CornerRadius="999" Margin="6,0,0,0" Padding="8,2"
                                Background="#2DA985">
                            <TextBlock x:Name="TotalOutputCountText" Text="—" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="个输出设备，已开启独占" FontSize="12" Foreground="#6A7A90"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Border CornerRadius="999" Margin="6,0,0,0" Padding="8,2"
                                Background="#3B82F6">
                            <TextBlock x:Name="ExclusiveCountText" Text="—" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="个" FontSize="12" Foreground="#6A7A90"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="BtnAllShared" Content="🔓 全部共享" Style="{StaticResource DevSetBtnGhost}"
                            Click="AllShared_Click"/>
                    <Button Grid.Column="4" x:Name="BtnAllExclusive" Content="🔒 全部独占" Style="{StaticResource DevSetBtnGhost}"
                            Click="AllExclusive_Click"/>
                    <Button Grid.Column="6" x:Name="BtnRefresh" Content="↻ 刷新设备" Style="{StaticResource DevSetBtnGhost}"
                            Click="RefreshDevices_Click"/>
                </Grid>
            </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DeviceRowBorder}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="🎤 输入设备" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#2B3A55"/>
                        <TextBlock Text="（只读，WASAPI 共享模式）" FontSize="11"
                                   Foreground="#6A7A90"
                                   VerticalAlignment="Center" Margin="8,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <ItemsControl ItemsSource="{Binding CaptureItems, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceExclusiveItem}">
                                    <Border Style="{StaticResource DeviceRowBorder}" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2B3A55"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border CornerRadius="999" Margin="8,0,0,0" Padding="6,2"
                                                        Visibility="{Binding IsVirtualCable, Converter={StaticResource Bool2Collapsed}}"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#79A6FF" Opacity="0.18"/>
                                                    </Border.Background>
                                                    <TextBlock Text="Cable" FontSize="10" FontWeight="SemiBold" Foreground="#3C6DC1"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="共享" FontSize="11"
                                                       Foreground="#6A7A90"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DeviceRowBorder}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="🔊 输出设备" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#2B3A55"/>
                        <TextBlock Text="（每个设备独立开关：🔓=共享 / 🔒=独占）" FontSize="11"
                                   Foreground="#6A7A90"
                                   VerticalAlignment="Center" Margin="8,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <ItemsControl ItemsSource="{Binding RenderItems, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceExclusiveItem}">
                                    <Border Style="{StaticResource DeviceRowBorder}" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2B3A55"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border CornerRadius="999" Margin="8,0,0,0" Padding="6,2"
                                                        Visibility="{Binding IsVirtualCable, Converter={StaticResource Bool2Collapsed}}"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#79A6FF" Opacity="0.18"/>
                                                    </Border.Background>
                                                    <TextBlock Text="Cable" FontSize="10" FontWeight="SemiBold" Foreground="#3C6DC1"/>
                                                </Border>
                                                <Border CornerRadius="999" Margin="6,0,0,0" Padding="6,2"
                                                        Visibility="{Binding IsExclusive, Converter={StaticResource Bool2Collapsed}}"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#E8A04A" Opacity="0.20"/>
                                                    </Border.Background>
                                                    <TextBlock Text="🔒 独占" FontSize="10" FontWeight="SemiBold" Foreground="#C77B1F"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding IsExclusive, Converter={StaticResource InvBool}, ConverterParameter=共享;独占}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="#6A7A90"/>
                                            <ToggleButton Grid.Column="4"
                                                          IsChecked="{Binding IsExclusive, Mode=TwoWay}"
                                                          Padding="10,4" FontSize="12"
                                                          ToolTip="开启独占：占用此输出设备，其他程序无法使用，延迟可降到 ~10-30ms；失败自动回退共享。仅下次启动生效。">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Foreground" Value="#6A7A90"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="#D9DFE9"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="Root" CornerRadius="8"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Root" Property="Background" Value="#FFFFFF"/>
                                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#2DA985"/>
                                                                            <Setter Property="Foreground" Value="#2DA985"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Foreground" Value="#B6C2D0"/>
                                                                            <Setter TargetName="Root" Property="Background" Value="#F6F8FB"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter Property="Foreground" Value="#C77B1F"/>
                                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#E8A04A"/>
                                                                            <Setter TargetName="Root" Property="Background" Value="#FDF3E4"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter Property="Content" Value="🔓"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Content" Value="🔒"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

            <!-- Row 6：说明 + 按钮（属于 ContentRoot 内的最后一行） -->
            <Border Grid.Row="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Foreground="#6A7A90" FontSize="11"
                               TextWrapping="Wrap">
                        <Run Text="提示：独占模式（方案C）能把该输出设备延迟再降低约 10-30ms，但："/>
                        <LineBreak/>
                        <Run Text="①占用后其它程序/系统声音无法再使用该设备；②硬件不支持会自动回退共享；③输入设备无法独占（NAudio WasapiCapture 只支持共享模式）。"/>
                    </TextBlock>
                    <Button Grid.Column="1" x:Name="BtnCancel" Content="取消" Style="{StaticResource DevSetBtnGhost}" Padding="22,7"
                            Click="Cancel_Click"/>
                    <Button Grid.Column="3" x:Name="BtnOk" Content="完成" Style="{StaticResource DevSetBtnPrimary}" Padding="26,7"
                            Click="Ok_Click"/>
                </Grid>
            </Border>
        </Grid>  <!-- === 关闭 ContentRoot === -->

        <!-- ========== Loading 遮罩：枚举设备时显示，阻止点击，内容区保持骨架 ========== -->
        <Border x:Name="LoadingMask" Background="#CCF6F8FB" Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                        Background="#2DA985">
                    <TextBlock Text="♪" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingText" Text="正在枚举音频设备…"
                               FontSize="14" FontWeight="SemiBold" Foreground="#2B3A55"/>
                    <TextBlock x:Name="LoadingSubText" Text="首次枚举可能需要 1-3 秒"
                               FontSize="12" Foreground="#6A7A90" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
